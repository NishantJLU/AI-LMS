// AI LMS — PostgreSQL schema (Auth.js + LMS + RAG-ready embeddings)

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum AssignmentPublishStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  LATE
  GRADED
}

enum QuizQuestionType {
  MCQ
  SHORT_ANSWER
}

enum AiGenerationType {
  SUMMARY
  KEY_CONCEPTS
  QUIZ
  FLASHCARDS
  ASSIGNMENT_FEEDBACK
  RECOMMENDATIONS
  SEMANTIC_REPLY
}

enum NotificationType {
  ASSIGNMENT
  ANNOUNCEMENT
  DISCUSSION
  GRADE
  SYSTEM
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// ——— Auth.js ———

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(STUDENT)

  title       String?
  department  String?
  bio         String?
  studyStreak Int       @default(0)

  accounts            Account[]
  sessions            Session[]
  coursesCreated      Course[]           @relation("CourseAuthor")
  courseInstructions  CourseInstructor[]
  enrollments         Enrollment[]
  submissions         Submission[]
  quizAttempts        QuizAttempt[]
  announcements       Announcement[]
  discussionsStarted  DiscussionThread[] @relation("ThreadAuthor")
  posts               DiscussionPost[]
  notifications       Notification[]
  aiGenerations       AiGeneration[]
  documentsUploaded   Document[]         @relation("DocumentUploader")
  flashcardSets       FlashcardSet[]
  attendance          AttendanceRecord[]
  reactions           DiscussionReaction[]
  gradedSubmissions   Submission[]       @relation("GradedBy")
  passwordResets      PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String
  userId    String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
}

model Course {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  code        String
  description String? @db.Text
  coverImage  String?
  published   Boolean @default(false)

  authorId String
  author   User   @relation("CourseAuthor", fields: [authorId], references: [id])

  instructors   CourseInstructor[]
  enrollments   Enrollment[]
  modules       Module[]
  assignments   Assignment[]
  quizzes       Quiz[]
  announcements Announcement[]
  discussions   DiscussionThread[]
  documents     Document[]
  flashcardSets FlashcardSet[]
  attendance    AttendanceRecord[]
  aiGenerations AiGeneration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([published])
}

model CourseInstructor {
  courseId String
  userId   String
  isLead   Boolean @default(false)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([courseId, userId])
  @@index([userId])
}

model Enrollment {
  id       String           @id @default(cuid())
  courseId String
  userId   String
  status   EnrollmentStatus @default(ACTIVE)
  progress Float            @default(0)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, userId])
  @@index([userId])
  @@index([courseId])
}

model Module {
  id          String  @id @default(cuid())
  courseId    String
  title       String
  description String? @db.Text
  sortOrder   Int     @default(0)
  published   Boolean @default(true)

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  assignments Assignment[]
  quizzes     Quiz[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
}

model Lesson {
  id          String @id @default(cuid())
  moduleId    String
  title       String
  content     String @db.Text
  sortOrder   Int    @default(0)
  durationMin Int?

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
}

model Assignment {
  id                 String                   @id @default(cuid())
  courseId           String
  moduleId           String?
  title              String
  description        String                   @db.Text
  dueAt              DateTime
  latePenaltyPercent Float                    @default(0)
  maxPoints          Float                    @default(100)
  status             AssignmentPublishStatus @default(DRAFT)
  rubric             Json?

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module Module? @relation(fields: [moduleId], references: [id])

  submissions Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([dueAt])
}

model Submission {
  id            String           @id @default(cuid())
  assignmentId  String
  userId        String
  content       String?          @db.Text
  fileUrl       String?
  fileName      String?
  status        SubmissionStatus @default(DRAFT)
  submittedAt   DateTime?
  grade         Float?
  feedback      String?          @db.Text
  gradedAt      DateTime?
  gradedById    String?
  aiFeedback    Json?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  gradedBy   User?      @relation("GradedBy", fields: [gradedById], references: [id])

  gradeHistory GradeChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, userId])
  @@index([userId])
}

model GradeChange {
  id           String   @id @default(cuid())
  submissionId String
  previous     Float?
  next         Float?
  note         String?
  changedById  String?
  createdAt    DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model Quiz {
  id           String  @id @default(cuid())
  courseId     String
  moduleId     String?
  title        String
  description  String? @db.Text
  timeLimitMin Int?
  published    Boolean @default(false)

  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module    Module?        @relation(fields: [moduleId], references: [id])
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
}

model QuizQuestion {
  id            String           @id @default(cuid())
  quizId        String
  type          QuizQuestionType
  question      String           @db.Text
  options       Json?
  correctAnswer String?          @db.Text
  points        Float            @default(1)
  sortOrder     Int              @default(0)

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model QuizAttempt {
  id          String    @id @default(cuid())
  quizId      String
  userId      String
  score       Float?
  answers     Json
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId, userId])
}

model FlashcardSet {
  id                 String  @id @default(cuid())
  title              String
  courseId           String?
  userId             String
  sourceAiGenerationId String?

  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  cards Flashcard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([courseId])
}

model Flashcard {
  id        String @id @default(cuid())
  setId     String
  front     String @db.Text
  back      String @db.Text
  sortOrder Int    @default(0)

  set FlashcardSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@index([setId])
}

model Announcement {
  id        String   @id @default(cuid())
  courseId  String
  authorId  String
  title     String
  body      String   @db.Text
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([courseId])
}

model AttendanceRecord {
  id       String           @id @default(cuid())
  courseId String
  userId   String
  date     DateTime         @db.Date
  status   AttendanceStatus
  note     String?

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId, date])
  @@index([courseId])
  @@index([userId])
}

model DiscussionThread {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  authorId  String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author User             @relation("ThreadAuthor", fields: [authorId], references: [id])
  posts  DiscussionPost[]

  @@index([courseId])
}

model DiscussionPost {
  id        String   @id @default(cuid())
  threadId  String
  parentId  String?
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thread   DiscussionThread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  parent   DiscussionPost?    @relation("PostReplies", fields: [parentId], references: [id])
  replies  DiscussionPost[]     @relation("PostReplies")
  author   User                 @relation(fields: [authorId], references: [id])
  reactions DiscussionReaction[]

  @@index([threadId])
  @@index([parentId])
}

model DiscussionReaction {
  id       String @id @default(cuid())
  postId   String
  userId   String
  emoji    String

  post DiscussionPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, emoji])
  @@index([postId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?          @db.Text
  read      Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model AiGeneration {
  id          String           @id @default(cuid())
  userId      String
  courseId    String?
  type        AiGenerationType
  prompt      String           @db.Text
  result      Json
  tokensUsed  Int?
  model       String?
  createdAt   DateTime         @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([courseId])
}

model Document {
  id            String  @id @default(cuid())
  courseId      String?
  lessonId      String?
  title         String
  filename      String
  url           String
  mimeType      String?
  sizeBytes     Int?
  textContent   String? @db.Text
  uploadedById  String

  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  uploader User    @relation("DocumentUploader", fields: [uploadedById], references: [id])

  chunks DocumentChunk[]

  createdAt DateTime @default(now())

  @@index([courseId])
  @@index([lessonId])
}

model DocumentChunk {
  id          String @id @default(cuid())
  documentId  String
  content     String @db.Text
  chunkIndex  Int
  tokenCount  Int?
  /// Embedding stored as JSON array for portability; swap to pgvector in production SQL migrations.
  embedding   Json?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}
